{
  "include": ["src/**/*", "types/**/*"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "es2021",
    "typeRoots": ["types", "node_modules/@types"],
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "dist"]
}
