{
  "name": "atcoder-difficulty-display",
  "version": "2.1.0",
  "description": "AtCoder Problemsの難易度を表示します。",
  "typeRoots": [
    "types",
    "node_modules/@types"
  ],
  "type": "module",
  "scripts": {
    "lint": "eslint --ignore-path .gitignore \"./src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --ignore-path .gitignore \"./src/**/*.{js,jsx,ts,tsx}\" --fix",
    "prettier": "prettier --write --ignore-path .gitignore \"**/*.{css,scss,html,js,json,jsx,md,ts,tsx}\"",
    "bundle": "rollup -c",
    "bundle:watch": "rollup -c -w"
  },
  "author": "hotarunw",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hotarunw/atcoder-difficulty-display/issues"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/tampermonkey": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "rollup": "^4.60.1",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-string": "^3.0.0",
    "sass": "^1.99.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@web/rollup-plugin-html": "^3.1.0",
    "atcoder-problems-api": "github:key-moon/atcoder-problems-api",
    "moment-es6": "^1.0.0"
  }
}
